FROM node:24-bookworm-slim AS dependencies
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
# `npm ci` runs the Prisma postinstall generator, which needs the schema before
# dependencies are installed. Keep this explicit so the staging image remains
# reproducible from a clean Docker cache.
COPY prisma ./prisma
RUN npm ci

FROM dependencies AS builder
COPY . .
RUN npm run build

FROM node:24-bookworm-slim AS web
WORKDIR /app
ENV NODE_ENV=production
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl \
  && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/.next-production/standalone ./
COPY --from=builder /app/.next-production/static ./.next-production/static
COPY --from=builder /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]

# The worker deliberately retains the checked-in TypeScript source and its
# development runtime. It is isolated from the web image so a web release is
# never coupled to an untraced `tsx` dependency.
FROM dependencies AS worker
WORKDIR /app
COPY . .
CMD ["npx", "tsx", "scripts/job-worker.ts"]

FROM worker AS migrate
CMD ["npx", "prisma", "migrate", "deploy"]
