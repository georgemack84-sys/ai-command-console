# Production configuration template — copy values into your deployment secret store.
# Do not deploy this file and do not commit actual secrets.

NODE_ENV=production
PORT=3000

# Persistent, writable storage. Use absolute paths in the deployment environment.
AI_COMMAND_CONSOLE_STORAGE_DRIVER=sqlite
AI_COMMAND_CONSOLE_DATA_ROOT=/var/lib/ai-command-console
AI_COMMAND_CONSOLE_DATABASE_PATH=/var/lib/ai-command-console/workspace.sqlite
AI_COMMAND_CONSOLE_AGENTS_DATABASE_PATH=/var/lib/ai-command-console/agents/console.sqlite
AI_COMMAND_CONSOLE_WRITE_LEGACY_JSON_MIRRORS=false

# Set both values in the deployment secret store. Keep AUTH_SECRET stable across restarts.
AI_COMMAND_CONSOLE_AUTH_SECRET=REPLACE_WITH_A_48_BYTE_RANDOM_BASE64_SECRET
ADMIN_SECRET=REPLACE_WITH_A_SEPARATE_LONG_RANDOM_SECRET

# Runtime safety posture.
AI_COMMAND_CONSOLE_SECURE_COOKIES=true
AI_COMMAND_CONSOLE_SESSION_MAX_AGE_SECONDS=1209600
SECURITY_MODE=enforced
OBSERVABILITY_MODE=full
CONTINUITY_VERIFICATION_ENABLED=true
INTEGRITY_VALIDATION_ENABLED=true
RESTORE_SIMULATION_ENABLED=true
FAIL_FAST_ON_STARTUP=true
DEBUG_MODE=false

# Run queue consumers outside the web process when deploying more than one instance.
JOB_QUEUE_EXECUTION_MODE=external

# Optional: delivers critical runtime alerts outside the application.
# AI_COMMAND_CONSOLE_ALERT_WEBHOOK_URL=https://alerts.example.invalid/noesis
