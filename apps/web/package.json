{
  "name": "@proprium/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run theme:bootstrap",
    "theme:bootstrap": "node scripts/copy-theme-bootstrap.mjs",
    "dev": "next dev",
    "prebuild": "npm run theme:bootstrap && node --import tsx scripts/validate-environment.mjs",
    "build": "next build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs --output-type err src/app src/config src/lib src/types src/components src/ui src/shell src/theme src/providers src/state",
    "architecture:fixtures:passing": "depcruise --config .dependency-cruiser.cjs --output-type err tests/architecture/fixtures/passing",
    "architecture:fixtures:failing": "node scripts/verify-architecture-fixtures.mjs",
    "architecture:verify-failure": "npm run architecture:fixtures:failing",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "test:browser": "playwright test",
    "test:theme": "vitest run src/theme tests/unit/theme-provider.test.tsx",
    "test:config-build-failure": "node scripts/verify-invalid-environment.mjs",
    "validate:frontend": "npm run format:check && npm run typecheck && npm run lint && npm run architecture:check && npm run architecture:fixtures:passing && npm run architecture:fixtures:failing && npm run test:theme && npm run test:coverage",
    "validate": "npm run validate:frontend"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "next": "16.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/nextjs-vite": "^10.5.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.37",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.2",
    "dependency-cruiser": "16.10.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.0",
    "jsdom": "29.0.1",
    "prettier": "3.8.2",
    "storybook": "^10.5.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.2"
  }
}
