{
  "name": "@proprium/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run theme:bootstrap",
    "theme:bootstrap": "node scripts/copy-theme-bootstrap.mjs",
    "dev": "next dev",
    "prebuild": "npm run theme:bootstrap && node --import tsx scripts/validate-environment.mjs",
    "build": "next build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives --report-unused-inline-configs error",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit --incremental false",
    "typescript:verify": "node scripts/verify-typescript-import-standards.mjs",
    "static-analysis:verify": "node scripts/verify-static-analysis.mjs",
    "ui-foundation:check": "node scripts/validate-ui-foundation.mjs",
    "ui-foundation:fixtures": "node scripts/verify-ui-foundation-fixtures.mjs",
    "validate:ui-foundation": "npm run ui-foundation:check && npm run ui-foundation:fixtures",
    "components:check": "node scripts/validate-core-components.mjs",
    "components:fixtures": "node scripts/verify-core-component-fixtures.mjs",
    "validate:components": "npm run components:check && npm run components:fixtures",
    "shell:check": "node scripts/validate-responsive-shell.mjs",
    "shell:fixtures": "node scripts/verify-responsive-shell-fixtures.mjs",
    "validate:shell": "npm run shell:check && npm run shell:fixtures",
    "overlays:check": "node scripts/validate-overlay-foundation.mjs",
    "overlays:fixtures": "node scripts/verify-overlay-foundation-fixtures.mjs",
    "validate:overlays": "npm run overlays:check && npm run overlays:fixtures",
    "route-states:check": "node scripts/validate-route-state-foundation.mjs",
    "route-states:fixtures": "node scripts/verify-route-state-fixtures.mjs",
    "validate:route-states": "npm run route-states:check && npm run route-states:fixtures",
    "week-2:check": "node scripts/validate-week-2-qualification.mjs",
    "week-2:fixtures": "node scripts/verify-week-2-qualification-fixtures.mjs",
    "validate:week-2": "npm run week-2:check && npm run week-2:fixtures",
    "authentication-ui:check": "node scripts/validate-authentication-ui.mjs",
    "authentication-ui:fixtures": "node scripts/verify-authentication-ui-fixtures.mjs",
    "validate:authentication-ui": "npm run authentication-ui:check && npm run authentication-ui:fixtures",
    "permissions:generate": "node scripts/generate-permission-catalog.mjs",
    "permissions:check": "node scripts/generate-permission-catalog.mjs --check",
    "permissions:validate": "node scripts/validate-permission-governance.mjs",
    "permissions:fixtures": "node scripts/verify-permission-fixtures.mjs",
    "transport:validate": "node scripts/validate-transport-boundary.mjs",
    "transport:fixtures": "node scripts/verify-transport-fixtures.mjs",
    "architecture": "npm run architecture:check && npm run architecture:fixtures:passing && npm run architecture:fixtures:failing",
    "architecture:check": "node scripts/run-dependency-cruiser.mjs --config .dependency-cruiser.cjs --output-type err src/app src/components src/config src/lib src/providers src/shell src/state src/theme src/types src/ui",
    "architecture:fixtures:passing": "node scripts/run-dependency-cruiser.mjs --config .dependency-cruiser.cjs --output-type err tests/architecture/fixtures/passing",
    "architecture:fixtures:failing": "node scripts/verify-architecture-fixtures.mjs",
    "architecture:verify-failure": "npm run architecture:fixtures:failing",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:verify": "node scripts/verify-formatting.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:storybook": "playwright test --config playwright.storybook.config.ts",
    "test:browser": "node scripts/test-browser.mjs",
    "test:browser:live-auth": "node scripts/test-browser-live-auth.mjs",
    "test:theme": "vitest run src/theme tests/unit/theme-provider.test.tsx",
    "test:config-build-failure": "node scripts/verify-invalid-environment.mjs",
    "test:secret-isolation": "node ../../scripts/validate-secret-artifacts.cjs --scope frontend --root .next/static --sentinel-env GP35_FRONTEND_SECRET_SENTINEL",
    "validate:frontend": "npm run format:check && npm run format:verify && npm run permissions:check && npm run permissions:validate && npm run permissions:fixtures && npm run transport:validate && npm run transport:fixtures && npm run static-analysis:verify && npm run typescript:verify && npm run validate:ui-foundation && npm run validate:components && npm run validate:shell && npm run validate:overlays && npm run validate:route-states && npm run validate:week-2 && npm run validate:authentication-ui && npm run typecheck && npm run lint && npm run architecture && npm run test:theme && npm run test:config-build-failure && npm run test:coverage",
    "validate": "npm run validate:frontend"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "next": "16.3.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/nextjs-vite": "^10.5.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.37",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.2",
    "dependency-cruiser": "16.10.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-import": "2.32.0",
    "jsdom": "29.0.1",
    "prettier": "3.8.2",
    "storybook": "^10.5.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.2"
  }
}
