# Proprium Web frontend environment template.
# Owner: Frontend
# Copy this file to .env.local for local development.
# Local counterpart: apps/web/.env.local (developer-owned and ignored)
# Safe to commit: public examples only; never add credentials or secret material.
# Every NEXT_PUBLIC_* value may be exposed to browser code.
NEXT_PUBLIC_APP_NAME=Proprium
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_ENVIRONMENT=development
