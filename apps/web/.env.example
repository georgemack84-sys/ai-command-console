# Proprium frontend environment template
# Owner: Frontend
# Local counterpart: apps/web/.env.local (developer-owned and ignored)
# Safe to commit: public examples only; never add credentials or secret material.
# NEXT_PUBLIC_* values are browser-visible build inputs.
NEXT_PUBLIC_APP_NAME=Proprium
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_ENVIRONMENT=development
