# Proprium Platform API environment template
# Owner: Platform API
# Local counterpart: services/api/.env (developer-owned and ignored)
# Safe to commit: non-production examples only; never add production secrets.
# Values below are development-only API runtime examples.

# Optional ASP.NET Core hosting overrides.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080

# Optional platform metadata overrides; appsettings.json supplies these defaults.
PLATFORM__NAME=Proprium
PLATFORM__VERSION=0.1.0

# Required PostgreSQL runtime configuration. The password is sensitive.
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DATABASE=proprium
POSTGRES_USER=proprium
POSTGRES_PASSWORD=local-development-only

# Redis host and port are required. The password is optional and sensitive when set.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Required session configuration. The example key is deterministic test-only material.
SESSION_TOKEN_DIGEST_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
SESSION_LIFETIME_MINUTES=480

# Required browser origin and login privacy key.
AUTH_ALLOWED_ORIGIN=http://localhost:3000
LOGIN_RATE_LIMIT_PRIVACY_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Optional locked/defaulted rate-limit values.
LOGIN_RATE_LIMIT_SOURCE=10
LOGIN_RATE_LIMIT_IDENTIFIER_SOURCE=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=5
LOGIN_RATE_LIMIT_FALLBACK_CAPACITY=10000

# Optional Development-only administrator bootstrap. Username and password are
# conditionally required only when LOCAL_ADMIN_ENABLED=true.
LOCAL_ADMIN_ENABLED=false
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD=
