  "taxonomyVersion": "1.0.0",
  "boundaryRules": [
    { "leftCategory": "QUESTION", "rightCategory": "FACT", "distinction": "A question requests information or expresses uncertainty; a fact asserts a descriptive claim.", "prohibitedInferences": ["QUESTION -> INSTRUCTION"] },
    { "leftCategory": "BRAINSTORM", "rightCategory": "IDEA", "distinction": "Brainstorming is an explicit exploratory context; an idea is one possible concept or course of action.", "prohibitedInferences": [] },
    { "leftCategory": "IDEA", "rightCategory": "SUGGESTION", "distinction": "An idea presents a possibility; a suggestion recommends it for consideration.", "prohibitedInferences": [] },
    { "leftCategory": "SUGGESTION", "rightCategory": "INSTRUCTION", "distinction": "A suggestion remains optional; an instruction requests an action.", "prohibitedInferences": ["SUGGESTION -> RULE"] },
    { "leftCategory": "PREFERENCE", "rightCategory": "INSTRUCTION", "distinction": "A preference is a non-mandatory tendency; an instruction is a directive.", "prohibitedInferences": [] },
    { "leftCategory": "INSTRUCTION", "rightCategory": "RULE", "distinction": "An instruction is a request in context; a rule is a continuing normative constraint.", "prohibitedInferences": [] },
    { "leftCategory": "RULE", "rightCategory": "PRINCIPLE", "distinction": "A rule constrains behavior; a principle guides judgment without itself prescribing an operation.", "prohibitedInferences": [] },
    { "leftCategory": "PRINCIPLE", "rightCategory": "PROCEDURE", "distinction": "A principle states guidance; a procedure specifies an operational method.", "prohibitedInferences": [] },
    { "leftCategory": "EXAMPLE", "rightCategory": "FACT", "distinction": "An example illustrates other content and retains containment; a fact asserts reality.", "prohibitedInferences": ["EXAMPLE -> RULE"] },
    { "leftCategory": "IDEA", "rightCategory": "DECISION", "distinction": "An idea is under consideration; a decision is an explicitly adopted choice.", "prohibitedInferences": ["IDEA -> DECISION"] },
    { "leftCategory": "SUGGESTION", "rightCategory": "DECISION", "distinction": "A suggestion proposes a course; a decision commits to one.", "prohibitedInferences": [] },
    { "leftCategory": "GOAL", "rightCategory": "DECISION", "distinction": "A goal describes a desired outcome; a decision adopts a specific choice.", "prohibitedInferences": [] },
    { "leftCategory": "FEEDBACK", "rightCategory": "PREFERENCE", "distinction": "Feedback assesses an outcome; a preference records a scoped desired tendency.", "prohibitedInferences": [] },
    { "leftCategory": "FEEDBACK", "rightCategory": "CORRECTION", "distinction": "Feedback evaluates an outcome; a correction identifies prior information as wrong or outdated.", "prohibitedInferences": [] },
    { "leftCategory": "CORRECTION", "rightCategory": "DECISION", "distinction": "A correction changes the standing of prior information; a decision adopts a choice.", "prohibitedInferences": [] },
    { "leftCategory": "EXCEPTION", "rightCategory": "RULE", "distinction": "An exception narrowly changes applicability; a rule remains the base continuing constraint.", "prohibitedInferences": ["PROCEDURE -> AUTHORIZATION"] }
  ],
