  statusTone                String                           @default("healthy")
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  members                   WorkspaceMember[]
  sources                   Source[]
  updates                   MonitoredUpdate[]
  insights                  Insight[]
  activity                  ActivityEvent[]
  savedViews                SavedView[]
  briefs                    ResearchBrief[]
  reports                   ResearchReport[]
  invites                   WorkspaceInvite[]
  alerts                    Alert[]
  featureFlags              WorkspaceFeatureFlag[]
  agentTasks                AgentTask[]
  operationsState           WorkspaceOperationsState?
  operationsFollowups       OperationsFollowup[]
  incidentApprovals         IncidentApprovalRequest[]
  policyOverride            WorkspacePolicyOverride?
  playbookRolloutWorkspaces PolicyPlaybookRolloutWorkspace[]
  knowledgeScopes           KnowledgeScope[]
  knowledgeEntries          KnowledgeEntry[]
  knowledgePromotions       KnowledgePromotion[]
  knowledgeSemanticKeys     KnowledgeSemanticKeyRecord[]
  noesisAuthorityBindings       NoesisAuthorityBinding[]
  noesisDurableRegistryStates   NoesisDurableRegistryState[]
  noesisDurableKnowledge        NoesisDurableKnowledgeRecord[]
  noesisGateAuditEvents         NoesisGateAuditEventRecord[]
  noesisDeferredCandidates      NoesisDeferredCandidateEvent[]
  noesisDeferredResolutions     NoesisDeferredResolutionEvent[]
  noesisLearningAuditEvents     NoesisLearningAuditEvent[]
  noesisTeachBacks              NoesisTeachBack[]
  noesisTeachBackEvaluations    NoesisTeachBackEvaluation[]
  noesisTeachBackReviews        NoesisTeachBackReview[]
  noesisCorrections             NoesisCorrection[]
  noesisCorrectionEvidence      NoesisCorrectionEvidence[]
  noesisPrincipleArtifacts      NoesisPrincipleArtifact[]
  noesisProcedureArtifacts      NoesisProcedureArtifact[]
  noesisExampleArtifacts        NoesisExampleArtifact[]
  noesisPreferenceArtifacts     NoesisPreferenceArtifact[]
  noesisDecisionArtifacts       NoesisDecisionArtifact[]
  noesisSkillArtifacts          NoesisSkillArtifact[]
  noesisSkillGraphArtifacts     NoesisSkillGraphArtifact[]
  noesisPracticeArtifacts       NoesisPracticeArtifact[]
  noesisEvaluationArtifacts     NoesisEvaluationArtifact[]
  noesisReflectionArtifacts     NoesisReflectionArtifact[]
  noesisSocraticArtifacts       NoesisSocraticArtifact[]
  noesisDecisionPredictionArtifacts NoesisDecisionPredictionArtifact[]
  noesisKnowledgeGapArtifacts NoesisKnowledgeGapArtifact[]
  noesisSelfDirectedLearningArtifacts NoesisSelfDirectedLearningArtifact[]
  noesisGovernedExecutionArtifacts NoesisGovernedExecutionArtifact[]
  noesisSourceCriticismArtifacts NoesisSourceCriticismArtifact[]
  noesisEpistemicSynthesisArtifacts NoesisEpistemicSynthesisArtifact[]
  noesisAutonomousPracticeArtifacts NoesisAutonomousPracticeArtifact[]
  noesisAdversarialExaminationArtifacts NoesisAdversarialExaminationArtifact[]
  noesisRetentionArtifacts NoesisRetentionArtifact[]
  noesisSkillDiscoveryArtifacts NoesisSkillDiscoveryArtifact[]
  noesisCapabilityArtifacts NoesisCapabilityArtifact[]
  noesisLearningAnalyticsArtifacts NoesisLearningAnalyticsArtifact[]
  noesisStrategyRegistryArtifacts NoesisStrategyRegistryArtifact[]
  noesisStrategyEvaluationArtifacts NoesisStrategyEvaluationArtifact[]
}

model KnowledgeScope {
  id          String             @id @default(cuid())
  workspaceId String
  name        String
  kind        KnowledgeScopeKind
  parentId    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      KnowledgeScope?    @relation("KnowledgeScopeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    KnowledgeScope[]   @relation("KnowledgeScopeHierarchy")
  records     KnowledgeEntry[]
  promotionTargets KnowledgePromotion[]

  @@index([workspaceId, kind])
  @@index([workspaceId, parentId])
}

model KnowledgeEntry {
  id                String                @id @default(cuid())
  workspaceId       String
  scopeId           String
  title             String
  content           String
  semanticKey       String
  semanticValue     String
  inheritance       KnowledgeInheritance  @default(local_only)
  visibility        String                @default("workspace")
  sourceKnowledgeId String?
  sourceScopeId     String?
  overrideOfId      String?
  supersededAt      DateTime?
  supersededById    String?
  createdById       String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scope             KnowledgeScope        @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  createdBy         User                  @relation("KnowledgeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sourceKnowledge   KnowledgeEntry?       @relation("KnowledgeSourceLineage", fields: [sourceKnowledgeId], references: [id], onDelete: SetNull)
  derivedKnowledge  KnowledgeEntry[]      @relation("KnowledgeSourceLineage")
  overrideOf        KnowledgeEntry?       @relation("KnowledgeOverrides", fields: [overrideOfId], references: [id], onDelete: SetNull)
  overrides         KnowledgeEntry[]      @relation("KnowledgeOverrides")
  promotionRequests KnowledgePromotion[]  @relation("KnowledgePromotionSource")
  promotedKnowledge KnowledgePromotion[]  @relation("KnowledgePromotionResult")

  @@index([workspaceId, scopeId, updatedAt])
  @@index([workspaceId, semanticKey])
  @@index([scopeId, inheritance])
  @@index([overrideOfId])
}

model KnowledgePromotion {
  id                  String                   @id @default(cuid())
  workspaceId         String
  sourceKnowledgeId   String
  targetScopeId       String
  promotedKnowledgeId String?                  @unique
  provenanceRecordId  String?                  @map("provenance_record_id")
  status              KnowledgePromotionStatus @default(pending)
  requestedById       String
  approvedById        String?
  rejectionReason     String?
  requestedAt         DateTime                 @default(now())
  resolvedAt          DateTime?
  workspace           Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceKnowledge     KnowledgeEntry           @relation("KnowledgePromotionSource", fields: [sourceKnowledgeId], references: [id], onDelete: Cascade)
  promotedKnowledge   KnowledgeEntry?          @relation("KnowledgePromotionResult", fields: [promotedKnowledgeId], references: [id], onDelete: SetNull)
  targetScope         KnowledgeScope           @relation(fields: [targetScopeId], references: [id], onDelete: Cascade)
  requestedBy         User                     @relation("KnowledgePromotionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy          User?                    @relation("KnowledgePromotionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, requestedAt])
  @@index([targetScopeId, status])
  @@index([workspaceId, provenanceRecordId])
}

model KnowledgeSemanticKeyRecord {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
