  workspaceId          String   @map("workspace_id")
  candidateId          String   @map("candidate_id")
  candidateFingerprint String   @map("candidate_fingerprint")
  gateDecisionId       String   @map("gate_decision_id")
  registryVersion      Int      @map("registry_version")
  payload              Json
  createdAt            DateTime @default(now()) @map("created_at")
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, candidateId])
  @@unique([workspaceId, gateDecisionId])
  @@index([workspaceId, registryVersion])
  @@map("noesis_durable_knowledge_records")
}

