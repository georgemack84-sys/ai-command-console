generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  viewer
  operator
  approver
  admin
}

enum UserStatus {
  active
  disabled
}

enum WorkspaceMemberRole {
  owner
  admin
  member
  viewer
}

enum WorkspaceInviteStatus {
  pending
  accepted
  revoked
}

enum SourceType {
  website
  repository
  integration
  feed
  document
}

enum SourceStatus {
  healthy
  degraded
  paused
}

enum AlertStatus {
  unread
  read
  archived
}

enum AlertSeverity {
  info
  warning
  critical
}

enum UpdateSeverity {
  low
  medium
  high
  critical
}

enum InsightType {
  summary
  insight
  recommendation
  classification
}

enum InsightStatus {
  ready
  draft
  archived
}

enum NuruDiscoveryCategory {
  near_certain
  adjacent
  serendipity
  wildcard
  featured
}

enum AgentTaskStatus {
  queued
  running
  completed
  failed
  canceled
}

enum AgentExecutionStatus {
  running
  completed
  failed
}

enum BriefStatus {
  draft
  queued
  in_progress
  in_review
  complete
}

enum BriefPriority {
  low
  medium
  high
}

enum ReportFormat {
  memo
  briefing
  comparison
  outline
}

enum ReportStatus {
  draft
  ready
  published
}

enum KnowledgeScopeKind {
  global
  program
  project
  component
  task
  session
}

enum KnowledgeInheritance {
  inheritable
  local_only
}

enum KnowledgePromotionStatus {
  pending
  approved
  rejected
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  passwordHash              String
  name                      String
  role                      UserRole                   @default(operator)
  status                    UserStatus                 @default(active)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  memberships               WorkspaceMember[]
  sessions                  AuthSession[]
  activities                ActivityEvent[]
  briefs                    ResearchBrief[]
  reports                   ResearchReport[]
  savedViews                SavedView[]
  alerts                    Alert[]
  createdInvites            WorkspaceInvite[]          @relation("CreatedWorkspaceInvites")
  acceptedInvites           WorkspaceInvite[]          @relation("AcceptedWorkspaceInvites")
  skillEvidence             SkillEvidence[]
  skillStates               SkillLearnerState[]
  skillRecommendationEvents SkillRecommendationEvent[]
  assessmentSessions        AssessmentSession[]
  competencyProfiles        CompetencyProfile[]
  assessmentRecommendations AssessmentRecommendation[]
  learningPlans             LearningPlan[]
  knowledgeEntries          KnowledgeEntry[]           @relation("KnowledgeCreatedBy")
  requestedKnowledgePromotions KnowledgePromotion[]    @relation("KnowledgePromotionRequestedBy")
  approvedKnowledgePromotions  KnowledgePromotion[]    @relation("KnowledgePromotionApprovedBy")
  nuruDiscoveryPreferences NuruUserDiscoveryPreference[]
  nuruInsightFeedback     NuruInsightFeedback?
  nuruRabbitHoleProgress  NuruRabbitHoleProgress[]
  nuruTasteSignals        NuruTasteSignal[]
  nuruPrivacySettings     NuruPrivacySettings?
  nuruDiscoverInterestSignals NuruDiscoverInterestSignal[]
  nuruDiscoverTopicPreferences NuruDiscoverTopicPreference[]
  nuruTasteInterviewResponses NuruTasteInterviewResponse[]
  nuruTasteProfileSignals NuruTasteProfileSignal[]
  nuruTasteEvidence NuruTasteEvidence[]
  nuruPersonalEditions NuruPersonalEdition[]
  nuruPersonalEditionFeedback NuruPersonalEditionFeedback[]
}

model NuruPrivacySettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  personalizationPaused Boolean  @default(false)
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NuruDiscovery {
  id          String                @id
  title       String
  meta        String
  category    NuruDiscoveryCategory
  matchScore  Int
  imageKey    String
  imageUrl    String?
  sourceUrl   String?
  eyebrow     String                @default("")
  summary     String                @default("")
  rationale   String                @default("")
  connection  String                @default("")
  paths       String[]              @default([])
  isPublished Boolean               @default(true)
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  preferences NuruUserDiscoveryPreference[]
  editionItems NuruDailyEditionItem[]
}

// Nuru Agents are deliberately separate from the discovery recommendation
// models above. Agents create proposals; only the governance service can
// promote a proposal to an archived knowledge item.
model NuruKnowledgeItem {
  id             String   @id @default(cuid())
  title          String
  content        String
  contentType    String
  status         String   @default("READY_FOR_REVIEW")
  project        String?
  relatedProjects Json    @default("[]")
  source         Json
  sourceId       String?
  metadata       Json
  relationships  Json
  confidence     Float
  currentVersion Int      @default(1)
  provenance     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  proposals      NuruCurationProposal[]
  sourceRecord   NuruSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  metadataRecords NuruMetadataRecord[]
  outgoingRelationships NuruRelationship[] @relation("NuruRelationshipSource")
  incomingRelationships NuruRelationship[] @relation("NuruRelationshipTarget")
  embeddingReferences NuruEmbeddingReference[]
  provenanceLinks NuruProvenanceLink[]
  discoverInterestSignals NuruDiscoverInterestSignal[]
  discoverCatalogEntry    NuruDiscoverCatalogEntry?

  @@index([status, createdAt])
  @@index([sourceId])
}

// Curator-approved identities used by Tandem's retrieval boundary. Aliases are
// separate so a name never becomes a canonical identity merely by being queried.
model NuruEntity {
  id            String            @id
  canonicalName String
  entityType    String
  status        String            @default("APPROVED")
  createdAt     DateTime          @default(now())
  aliases       NuruEntityAlias[]

  @@index([status, canonicalName])
}

model NuruEntityAlias {
  id              String     @id
  entityId        String
  alias           String
  normalizedAlias String     @unique
  createdAt       DateTime   @default(now())
  entity          NuruEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
}

// Immutable Tandem mission context snapshots. They do not participate in Nuru's
// curation or canonical knowledge lifecycle.
model TandemMissionKnowledgePackage {
  id               String   @id
  workspaceId      String
  missionId        String
  packageId        String
  attachedBy       String
  attachedAt       DateTime @default(now())
  knowledgePackage Json

  @@unique([workspaceId, missionId, packageId])
  @@index([workspaceId, missionId, attachedAt])
}

// Receipt of a Tandem proposal entering Nuru curation. It records no admission
// decision and is intentionally independent of canonical knowledge items.
model TandemKnowledgeCandidateReceipt {
  id                String   @id
  workspaceId       String
  candidateId       String
  missionId         String
  curationProposalId String
  receivedAt        DateTime @default(now())
  payload           Json

  @@unique([workspaceId, candidateId])
  @@index([workspaceId, missionId, receivedAt])
  @@index([curationProposalId])
}

model TandemKnowledgeSubscription {
  subscriptionId String @id
  workspaceId String
  missionId String
  entityIds Json
  topics Json
  eventTypes Json
  significanceThreshold String
  createdAt DateTime @default(now())
  @@index([workspaceId, missionId, createdAt])
}

model TandemKnowledgeSubscriptionDelivery {
  id String @id
  subscriptionId String
  missionId String
  updateId String
  deliveredAt DateTime @default(now())
  @@unique([subscriptionId, updateId])
  @@index([missionId, deliveredAt])
}

model NuruDiscoveryCandidate {
  id               String   @id @default(cuid())
  title            String
  content          String
  source           Json
  reasonDiscovered String
  initialType      String
  relevanceScore   Int
  confidence       Float
  status           String   @default("CANDIDATE")
  createdBy        String
  correlationId    String
  externalKey      String?  @unique
  createdAt        DateTime @default(now())
  personalEditionItems NuruPersonalEditionItem[]
  personalEditionFeedback NuruPersonalEditionFeedback[]

  @@index([status, createdAt])
  @@index([correlationId])
}

model NuruPersonalEdition {
  id             String                    @id @default(cuid())
  userId         String
  editionDate    DateTime
  rankingVersion String
  inputSnapshot  Json
  createdAt      DateTime                  @default(now())
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          NuruPersonalEditionItem[]

  @@unique([userId, editionDate])
  @@index([userId, createdAt])
}

model NuruPersonalEditionItem {
  id             String                @id @default(cuid())
  editionId      String
  candidateId    String
  position       Int
  lane           String
  score          Int
  scoreBreakdown Json
  explanation    String
  shownAt        DateTime              @default(now())
  edition        NuruPersonalEdition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  candidate      NuruDiscoveryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([editionId, position])
  @@unique([editionId, candidateId])
  @@index([candidateId, shownAt])
}

model NuruPersonalEditionFeedback {
  id          String   @id @default(cuid())
  userId      String
  candidateId String
  action      String
  reasonCode  String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate   NuruDiscoveryCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, candidateId, createdAt])
}

model NuruDiscoveryRetrievalRun {
  id            String   @id @default(cuid())
  sourceId      String
  query         String
  status        String
  candidateCount Int     @default(0)
  failureReason String?
  policyVersion String
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([sourceId, startedAt])
  @@index([status, startedAt])
}

model NuruContextAssessment {
  id               String   @id @default(cuid())
  candidateId      String
  project          String?
  relatedProjects  Json    @default("[]")
  topic            String
  artifactType     String
  scope            String
  sourceContext    String
  likelyPurpose    String
  dependencies     Json
  applicableSystem String?
  historicalContext String?
  relatedComponents Json
  confidence       Float
  createdBy        String
  correlationId    String
  createdAt        DateTime @default(now())

  @@index([candidateId, createdAt])
  @@index([correlationId])
}

model NuruQualityAssessment {
  id                    String   @id @default(cuid())
  itemId                String
  status                String
  sourceKnown           Boolean
  provenanceAvailable   Boolean
  duplicateState        String
  conflictDetected      Boolean
  contextAccurate       Boolean
  relationshipsJustified Boolean
  evidenceSufficient    Boolean
  confidence            Float
  warnings              Json
  createdBy             String
  correlationId         String
  createdAt             DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([correlationId])
}

model NuruSource {
  id          String   @id @default(cuid())
  sourceType  String
  origin      String
  uri         String?
  location    String?
  author      String?
  authority   String
  checksum    String?
  version     String?
  derivedFromSourceId String?
  retrievedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  items       NuruKnowledgeItem[]

  @@index([checksum])
  @@index([origin])
  @@index([derivedFromSourceId])
}

// NSI-02: Source identity and admission policy. This is intentionally distinct
// from the legacy monitoring Source record and from artifact-level NuruSource.
model NuruSourceRegistry {
  id                  String   @id
  workspaceId         String
  name                String
  domain              String?
  baseUrl             String?
  category            String
  topics              String[]
  authorityClass      String
  ingestionMethods    String[]
  refreshPolicy       String
  admissionState      String
  operationalState    String
  enabled             Boolean  @default(true)
  requiresReview      Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lastCheckedAt       DateTime?
  lastSuccessfulFetch DateTime?

  @@index([workspaceId, admissionState])
  @@index([workspaceId, domain])
}

// NSI-03: original bytes are retained before any extraction, normalization, or
// claim analysis. This table is append-only at the application boundary.
model NuruRawArtifact {
  id               String   @id
  workspaceId      String
  sourceRegistryId String
  originUrl        String?
  contentType      String
  body             Bytes
  contentHash      String
  byteLength       Int
  originalFilename String?
  submittedBy      String
  retrievedAt      DateTime
  createdAt        DateTime @default(now())

  @@index([workspaceId, sourceRegistryId, retrievedAt])
  @@index([contentHash])
  @@unique([workspaceId, sourceRegistryId, contentHash])
}

// NSI-09/10: a working document derived from, but never replacing, raw bytes.
model NuruNormalizedDocument {
  id               String   @id
  workspaceId      String
  rawArtifactId    String   @unique
  sourceRegistryId String
  status           String
  title            String?
  content          String?
  sections         Json
  language         String?
  extractionMethod String
  contentHash      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceId, sourceRegistryId, status])
}

// NSI-13: candidates are evidence references, not knowledge assertions.
model NuruClaimCandidate {
  id                   String   @id
  workspaceId          String
  normalizedDocumentId String
  rawArtifactId        String
  sourceRegistryId     String
  claimText            String
  claimType            String
  confidence           Float
  passageReference     String
  passageText          String
  fingerprint          String
  status               String
  extractionMethod     String
  reviewedBy           String?
  reviewReason         String?
  reviewedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([normalizedDocumentId, fingerprint])
  @@index([workspaceId, status, createdAt])
  @@index([rawArtifactId, passageReference])
}

// NSI-15: class is an assessment of a particular source supporting a particular
// claim in context. It is not a blanket trust score and cannot admit knowledge.
model NuruSourceClassification {
  id               String   @id
  workspaceId      String
  claimCandidateId String
  sourceRegistryId String
  sourceClass      String
  context          String
  rationale        String
  classifiedBy     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([claimCandidateId, sourceRegistryId])
  @@index([workspaceId, sourceRegistryId, createdAt])
  @@index([claimCandidateId])
}

// NSI-16: a Quality Agent verdict for evidence, never a canonical admission.
model NuruClaimEvidenceQuality {
  id               String   @id
  workspaceId      String
  claimCandidateId String
  status           String
  confidence       Float
  sourceAuthority  String
  freshness        String
  independence     String
  corroboration    String
  conflicts        String
  missingEvidence  String[]
  warnings         String[]
  qualityRunId     String?
  assessedBy       String
  createdAt        DateTime @default(now())

  @@index([workspaceId, claimCandidateId, createdAt])
}

// NSI-17: supporting claim provenance is counted by independent origin, not by URL volume.
model NuruClaimCorroboration {
  id                    String   @id
  workspaceId           String
  claimCandidateId      String
  supportingClaimId     String
  sourceRelationship    String
  supportsClaim         Boolean
  rationale             String
  recordedBy            String
  createdAt             DateTime @default(now())

  @@unique([claimCandidateId, supportingClaimId])
  @@index([workspaceId, claimCandidateId, createdAt])
}

// NSI-18: operational investigation candidates. Priority is never an evidence or truth score.
model NuruUrlFrontierEntry {
  id                String   @id
  workspaceId       String
  sourceRegistryId  String
  url               String
  status            String
  topicRelevance    Int
  sourceAuthority   Int
  freshness         Int
  changeProbability Int
  crawlCost         Int
  userInterest      Int
  priority          Int
  lastFetchedAt     DateTime?
  queuedBy          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([workspaceId, url])
  @@index([workspaceId, status, priority, createdAt])
}

// NSI-19: scheduler output only. A scheduled job does not itself acquire content.
model NuruCrawlScheduleJob {
  id              String   @id
  workspaceId     String
  frontierEntryId String
  sourceRegistryId String
  cadence         String
  status          String
  dueAt           DateTime
  scheduledBy     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([frontierEntryId])
  @@index([workspaceId, status, dueAt])
}

// NSI-20: immutable comparison between retained document versions.
model NuruSourceChangeEvent {
  id                  String   @id
  workspaceId         String
  previousDocumentId  String
  currentDocumentId   String
  changeTypes         String[]
  summary             String
  previousContentHash String?
  currentContentHash  String?
  detectedBy          String
  createdAt           DateTime @default(now())

  @@unique([previousDocumentId, currentDocumentId])
  @@index([workspaceId, currentDocumentId, createdAt])
}

// HF01/02: an append-only record of an event that may change Nuru's durable
// understanding. Developments are evidence for later curation; they are never
// canonical knowledge and have no admission authority.
model NuruKnowledgeDevelopment {
  id                String   @id
  workspaceId       String
  subjectId         String
  type              String
  eventTime         DateTime
  publicationTime   DateTime?
  discoveryTime     DateTime
  summary           String
  claims            Json
  evidence          Json
  entities          Json
  sourceAuthority   String
  verificationState String
  provenance        Json
  createdBy         String
  correlationId     String
  createdAt         DateTime @default(now())

  @@index([workspaceId, subjectId, eventTime])
  @@index([workspaceId, verificationState, createdAt])
  @@index([correlationId])
}

// HF03/05/08: a claim's observed state at a point in time. These are
// append-only evidence records, separate from canonical NuruKnowledgeItem.
model NuruTemporalClaim {
  id                String   @id
  workspaceId       String
  subjectId         String
  predicate         String
  value             Json
  normalizedValue   String
  state             String
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  assertedAt        DateTime
  observedAt        DateTime
  recordedAt        DateTime @default(now())
  developmentId     String?
  evidence          Json
  provenance        Json
  createdBy         String
  correlationId     String

  @@index([workspaceId, subjectId, predicate, effectiveFrom])
  @@index([workspaceId, state, recordedAt])
  @@index([developmentId])
}

// A correction request does not mutate either claim. The separate decision
// record makes the review history auditable and preserves rejected corrections.
model NuruKnowledgeCorrection {
  id                    String   @id
  workspaceId           String
  subjectId             String
  previousClaimId       String
  correctedClaimId      String
  reason                String
  evidence              Json
  requestedBy           String
  correlationId         String
  createdAt             DateTime @default(now())

  @@index([workspaceId, subjectId, createdAt])
  @@index([previousClaimId])
  @@index([correctedClaimId])
}

model NuruKnowledgeCorrectionDecision {
  id            String   @id
  correctionId  String
  action        String
  reason        String
  decidedBy     String
  correlationId String
  createdAt     DateTime @default(now())

  @@unique([correctionId])
  @@index([correctionId, createdAt])
}

// HF06: receipt proving that a specific stabilized Headline Flow event version
// has entered Nuru curation. It prevents duplicate bridge submissions.
model NuruHeadlineFlowCandidate {
  id                  String   @id @default(cuid())
  workspaceId         String
  eventId             String
  eventVersion        Int
  subjectId           String
  developmentId       String
  curationProposalId  String
  createdAt           DateTime @default(now())

  @@unique([workspaceId, eventId, eventVersion])
  @@index([workspaceId, subjectId, createdAt])
  @@index([curationProposalId])
}

// NSI-25: discovery proposals are not registry entries and cannot authorize acquisition.
model NuruSourceDiscoveryProposal {
  id          String   @id
  workspaceId String
  name        String
  url         String
  domain      String
  category    String
  rationale   String
  status      String
  proposedBy  String
  createdAt   DateTime @default(now())

  @@unique([workspaceId, url])
  @@index([workspaceId, status, createdAt])
}

// NSI-26: domain usefulness is contextual metadata, not an authority upgrade.
model NuruSourceSpecialization {
  id               String   @id
  workspaceId      String
  sourceRegistryId String
  domain           String
  usefulness       Int
  rationale        String
  assessedBy       String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sourceRegistryId, domain])
  @@index([workspaceId, domain, usefulness])
}

// NSI-27: conflicting claims remain preserved while investigation is required.
model NuruClaimConflict {
  id                String   @id
  workspaceId       String
  claimCandidateId  String
  conflictingClaimId String
  status            String
  rationale         String
  detectedBy        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([claimCandidateId, conflictingClaimId])
  @@index([workspaceId, status, createdAt])
}

// NSI-28: stale evidence is a revalidation signal, not an automatic rejection.
model NuruClaimStalenessAssessment {
  id               String   @id
  workspaceId      String
  claimCandidateId String
  status           String
  ageDays          Int
  thresholdDays    Int
  rationale        String
  assessedBy       String
  createdAt        DateTime @default(now())

  @@index([workspaceId, status, createdAt])
  @@index([claimCandidateId, createdAt])
}

// NSI-29: bounded research requests; missions cannot directly acquire or admit information.
model NuruResearchMission {
  id               String   @id
  workspaceId      String
  claimCandidateId String?
  question         String
  rationale        String
  status           String
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([workspaceId, status, createdAt])
}

model NuruProvenanceLink {
  id              String   @id @default(cuid())
  knowledgeItemId String
  sequence        Int
  stage           String
  referenceId     String
  actor           String
  details         Json     @default("{}")
  createdAt       DateTime @default(now())
  knowledgeItem   NuruKnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@unique([knowledgeItemId, sequence])
  @@index([referenceId])
}

model NuruDuplicateAssessment {
  id            String   @id @default(cuid())
  itemId        String
  matchedItemId String?
  result        String
  contentHash   String
  metadataScore Float
  semanticScore Float
  confidence    Float
  evidence      Json
  createdAt     DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([contentHash])
}

model NuruContradictionAssessment {
  id            String   @id @default(cuid())
  itemId        String
  relatedItemId String
  state         String
  confidence    Float
  evidence      Json
  investigation Json
  createdAt     DateTime @default(now())

  @@index([itemId, createdAt])
  @@index([relatedItemId])
}

model NuruSupersessionReview {
  id              String   @id @default(cuid())
  currentItemId   String
  candidateItemId String
  status          String
  reason          String
  requestedBy     String
  decidedBy       String?
  decisionReason  String?
  narrowedScope   String?
  correlationId   String
  decidedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([status, createdAt])
  @@index([currentItemId])
  @@index([candidateItemId])
}

model NuruCurationQueue {
  id            String   @id @default(cuid())
  candidateId   String?
  itemId        String?
  proposalId    String?  @unique
  status        String
  lane          String?
  priority      Int      @default(50)
  reason        String
  correlationId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, priority, createdAt])
  @@index([candidateId])
  @@index([itemId])
}

// Durable claim for a caller-supplied submission key. It prevents a retry from
// starting a second curator workflow while the first is still in progress.
model NuruCurationSubmissionReceipt {
  id             String   @id @default(cuid())
  actorId        String
  idempotencyKey String
  status         String   @default("PROCESSING")
  request        Json     @default("{}")
  correlationId  String?
  proposalId     String?
  queueId        String?
  result         Json     @default("{}")
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([actorId, idempotencyKey])
  @@index([status, updatedAt])
}

model NuruHumanFeedback {
  id                  String   @id @default(cuid())
  proposalId          String
  agentRecommendation String
  humanDecision       String
  reason              String
  scope               String?
  reviewer            String
  correlationId       String
  evaluationStatus    String   @default("PENDING_REVIEW")
  createdAt           DateTime @default(now())

  @@index([proposalId, createdAt])
  @@index([evaluationStatus, createdAt])
}

model NuruMetadataRecord {
  id        String   @id @default(cuid())
  itemId    String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  item      NuruKnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, key])
}

model NuruRelationship {
  id               String   @id @default(cuid())
  sourceItemId     String
  targetItemId     String
  relationshipType String
  confidence       Float
  evidence         String
  proposedBy       String
  status           String   @default("PROPOSED")
  createdAt        DateTime @default(now())
  sourceItem       NuruKnowledgeItem @relation("NuruRelationshipSource", fields: [sourceItemId], references: [id], onDelete: Cascade)
  targetItem       NuruKnowledgeItem @relation("NuruRelationshipTarget", fields: [targetItemId], references: [id], onDelete: Cascade)

  @@index([sourceItemId, status])
  @@index([targetItemId, status])
}

model NuruCurationProposal {
  id              String   @id @default(cuid())
  itemId          String
  recommendation  String
  classification  String
  project         String?
  qualityStatus   String
  confidence      Float
  evidence        Json
  reasoningSummary String
  warnings        Json
  requiredReview  Boolean  @default(true)
  status          String   @default("HUMAN_REVIEW_REQUIRED")
  createdBy       String
  decisionReason  String?
  reviewedBy      String?
  reviewedAt      DateTime?
  submissionReceiptId String? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  item            NuruKnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  runs            NuruAgentRun[]
  auditEvents     NuruAuditEvent[]
  decisions       NuruCurationDecision[]

  @@index([status, createdAt])
}

model NuruAgentRun {
  id            String   @id @default(cuid())
  proposalId    String?
  agentId       String
  agentType     String
  status        String
  objective     String
  inputContext  Json     @default("{}")
  result        Json
  correlationId String
  model         String
  promptVersion String
  policyVersion String
  identitySnapshot Json
  durationMs    Int?
  tokenUsage    Int      @default(0)
  toolUsage     Json     @default("[]")
  modelCost     Float    @default(0)
  retryCount    Int      @default(0)
  createdAt     DateTime @default(now())
  proposal      NuruCurationProposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
}

model NuruAgentIdentity {
  agentId       String   @id
  agentType     String
  role          String
  version       String
  model         String
  permissions   Json
  tools         Json
  policyProfile String
  promptVersion String
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, agentType])
}

model NuruAuditEvent {
  id            String   @id @default(cuid())
  proposalId    String?
  eventType     String
  actor         String
  agentRunId    String?
  resourceId    String
  inputReference String?
  outputReference String?
  decision      String?
  reason        String?
  correlationId String
  createdAt     DateTime @default(now())
  proposal      NuruCurationProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([resourceId, createdAt])
  @@index([proposalId, createdAt])
}

model NuruCurationDecision {
  id         String   @id @default(cuid())
  proposalId String
  outcome    String
  decidedBy  String
  reason     String
  decidedAt  DateTime @default(now())
  proposal   NuruCurationProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, decidedAt])
}

model NuruEmbeddingReference {
  id          String   @id @default(cuid())
  itemId      String
  provider    String
  model       String
  externalRef String
  createdAt   DateTime @default(now())
  item        NuruKnowledgeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([provider, externalRef])
  @@index([itemId])
}

model NuruDailyEdition {
  id        String                 @id @default(cuid())
  editionAt DateTime               @unique
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  items     NuruDailyEditionItem[]
}

model NuruDailyEditionItem {
  id          String           @id @default(cuid())
  editionId   String
  discoveryId String
  position    Int
  isFeatured  Boolean          @default(false)
  edition     NuruDailyEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  discovery   NuruDiscovery    @relation(fields: [discoveryId], references: [id], onDelete: Cascade)

  @@unique([editionId, discoveryId])
  @@unique([editionId, position])
  @@index([editionId, isFeatured])
}

model NuruDailyEditionCandidate {
  id           String   @id @default(cuid())
  editionAt    DateTime @unique
  discoveryIds String[]
  featuredId   String?
  status       String   @default("prepared")
  generatedAt  DateTime @default(now())
  reviewedAt   DateTime?
}

model NuruUserDiscoveryPreference {
  id          String        @id @default(cuid())
  userId      String
  discoveryId String
  savedAt     DateTime?
  dismissedAt DateTime?
  affinity    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  discovery   NuruDiscovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)

  @@unique([userId, discoveryId])
  @@index([userId, savedAt])
  @@index([userId, dismissedAt])
}

model NuruInsightFeedback {
  id        String   @id @default(cuid())
  userId    String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NuruRabbitHole {
  id        String                  @id
  title     String
  subtitle  String
  coverKey  String
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  steps     NuruRabbitHoleStep[]
  progress  NuruRabbitHoleProgress[]
}

model NuruRabbitHoleStep {
  id           String         @id
  rabbitHoleId String
  position     Int
  title        String
  description  String
  rabbitHole   NuruRabbitHole @relation(fields: [rabbitHoleId], references: [id], onDelete: Cascade)

  @@unique([rabbitHoleId, position])
}

model NuruRabbitHoleProgress {
  id             String         @id @default(cuid())
  userId         String
  rabbitHoleId   String
  completedSteps String[]       @default([])
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rabbitHole     NuruRabbitHole @relation(fields: [rabbitHoleId], references: [id], onDelete: Cascade)

  @@unique([userId, rabbitHoleId])
  @@index([userId, updatedAt])
}

model NuruTasteSignal {
  id          String   @id @default(cuid())
  userId      String
  nodeId      String
  label       String
  cluster     String
  score       Int
  isActive    Boolean  @default(true)
  confirmedAt DateTime?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId, isActive, score])
}

// Discover feedback is append-only user preference evidence. It never changes
// the referenced knowledge item or grants authority over its canonical status.
model NuruDiscoverInterestSignal {
  id              String   @id @default(cuid())
  userId          String
  knowledgeItemId String
  signalType      String
  weight          Int
  source          String
  reasonCode      String?
  createdAt       DateTime @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeItem   NuruKnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([userId, knowledgeItemId, createdAt])
  @@index([knowledgeItemId, createdAt])
}

// Explicit, editable user topic choices for Discover. These are private
// preference inputs, not inferred profile data and never affect canonical knowledge.
model NuruDiscoverTopicPreference {
  id        String   @id @default(cuid())
  userId    String
  topic     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([userId, updatedAt])
}

// Interview answers and their interpretations are separate. Answers are raw,
// user-owned evidence; profile signals remain tentative and correctable.
model NuruTasteInterviewResponse {
  id        String   @id @default(cuid())
  userId    String
  promptId  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, promptId])
  @@index([userId, updatedAt])
}

model NuruTasteProfileSignal {
  id            String   @id @default(cuid())
  userId        String
  concept       String
  dimension     String
  polarity      Int
  confidence    Float
  evidenceCount Int      @default(0)
  status        String   @default("CANDIDATE")
  source        String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence      NuruTasteEvidence[]

  @@unique([userId, concept, dimension, source])
  @@index([userId, isActive, updatedAt])
}

model NuruTasteEvidence {
  id        String   @id @default(cuid())
  userId    String
  signalId  String
  sourceType String
  sourceId  String
  summary   String
  weight    Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal    NuruTasteProfileSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([signalId, createdAt])
}

// Presentation admission is deliberately separate from canonical knowledge.
// Withdrawing an entry removes it from Discover without altering the record.
model NuruDiscoverCatalogEntry {
  id              String   @id @default(cuid())
  knowledgeItemId String   @unique
  status          String   @default("ACTIVE")
  topics          String[] @default([])
  reason          String
  admittedBy      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  knowledgeItem   NuruKnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model SkillNode {
  id                   String                @id
  slug                 String                @unique
  name                 String
  description          String
  status               String
  modelVersion         String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  outgoingEdges        SkillEdge[]           @relation("SkillEdgeFrom")
  incomingEdges        SkillEdge[]           @relation("SkillEdgeTo")
  evidence             SkillEvidence[]
  states               SkillLearnerState[]
  assessmentBlueprints AssessmentBlueprint[]
  assessmentItems      AssessmentItem[]
  competencyProfiles   CompetencyProfile[]
}

model SkillEdge {
  id          String    @id
  fromSkillId String
  toSkillId   String
  type        String
  strength    Float?
  rationale   String
  createdAt   DateTime  @default(now())
  fromSkill   SkillNode @relation("SkillEdgeFrom", fields: [fromSkillId], references: [id], onDelete: Cascade)
  toSkill     SkillNode @relation("SkillEdgeTo", fields: [toSkillId], references: [id], onDelete: Cascade)

  @@unique([fromSkillId, toSkillId, type])
}

model SkillEvidence {
  id                   String             @id
  learnerId            String
  skillId              String
  kind                 String
  occurredAt           DateTime
  score                Float?
  outcome              String
  evaluator            String
  sourceRef            String?
  notes                String?
  rubricVersion        String?
  assessmentSessionId  String?
  assessmentItemId     String?
  evaluationType       String?
  competencyDimensions String[]
  learner              User               @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  skill                SkillNode          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  assessmentSession    AssessmentSession? @relation("AssessmentSessionEvidence", fields: [assessmentSessionId], references: [id], onDelete: SetNull)
  assessmentItem       AssessmentItem?    @relation("AssessmentItemEvidence", fields: [assessmentItemId], references: [id], onDelete: SetNull)

  @@index([learnerId, skillId, occurredAt])
  @@index([assessmentSessionId])
  @@index([assessmentItemId])
}

model AssessmentBlueprint {
  id                 String              @id @default(cuid())
  skillId            String
  version            String
  objectives         Json
  assessedSkillIds   String[]
  targetCompetencies String[]
  itemMix            Json
  itemPlan           Json
  rules              Json
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  skill              SkillNode           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  items              AssessmentItem[]
  sessions           AssessmentSession[]

  @@unique([skillId, version])
}

model AssessmentItem {
  id                     String               @id @default(cuid())
  skillId                String
  blueprintId            String?
  evaluationType         String
  prompt                 String
  expectedResponseFormat String
  rubric                 Json
  difficulty             Int
  version                String
  competencyDimensions   String[]
  content                Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  skill                  SkillNode            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  blueprint              AssessmentBlueprint? @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  responses              AssessmentResponse[]
  sessionItems           AssessmentSessionItem[]
  evidence               SkillEvidence[]      @relation("AssessmentItemEvidence")

  @@index([skillId, evaluationType, version])
  @@index([blueprintId])
}

model AssessmentSession {
  id                 String                    @id @default(cuid())
  learnerId          String
  blueprintId        String
  targetSkillIds     String[]
  state              String
  blueprintVersion   String
  startedAt          DateTime                  @default(now())
  completedAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  learner            User                      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  blueprint          AssessmentBlueprint       @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  responses          AssessmentResponse[]
  sessionItems       AssessmentSessionItem[]
  evidence           SkillEvidence[]           @relation("AssessmentSessionEvidence")
  competencyProfiles CompetencyProfile[]
  recommendation     AssessmentRecommendation?

  @@index([learnerId, state])
}

model AssessmentResponse {
  id                  String            @id @default(cuid())
  sessionId           String
  itemId              String
  answer              Json
  selfRatedConfidence Float?
  evaluationResult    Json?
  feedback            String?
  submittedAt         DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  session             AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item                AssessmentItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([sessionId, itemId])
  @@index([itemId])
}

model AssessmentSessionItem {
  id        String            @id @default(cuid())
  sessionId String
  itemId    String
  position  Int
  createdAt DateTime          @default(now())
  session   AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item      AssessmentItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([sessionId, itemId])
  @@unique([sessionId, position])
  @@index([itemId])
}

model CompetencyProfile {
  id                 String            @id @default(cuid())
  sessionId          String
  learnerId          String
  skillId            String
  knowledge          Float?
  application        Float?
  troubleshooting    Float?
  retention          Float?
  calibration        Float?
  score              Float?
  confidenceInterval Json
  evidenceCount      Int
  calculationVersion String
  calculatedAt       DateTime          @default(now())
  session            AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learner            User              @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  skill              SkillNode         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([sessionId, skillId])
  @@index([learnerId, skillId, calculatedAt])
}

model AssessmentRecommendation {
  id                         String            @id @default(cuid())
  sessionId                  String            @unique
  learnerId                  String
  instructionalStartingPoint String
  priorityGaps               Json
  retestAt                   DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  session                    AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learner                    User              @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, createdAt])
}

model SkillLearnerState {
  id                 String    @id @default(cuid())
  learnerId          String
  skillId            String
  mastery            Float?
  confidence         Float
  retentionScore     Float?
  lastEvaluated      DateTime?
  displayState       String
  calculationVersion String
  calculatedAt       DateTime
  evidenceIds        String[]
  learner            User      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  skill              SkillNode @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([learnerId, skillId])
}

model SkillRecommendationEvent {
  id             String   @id @default(cuid())
  learnerId      String
  targetSkillId  String?
  blockedSkillId String
  outcome        String
  createdAt      DateTime @default(now())
  learner        User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, createdAt])
}

model LearningPlan {
  id          String               @id @default(cuid())
  learnerId   String
  version     String
  status      String
  goal        Json
  constraints Json
  plan        Json
  createdAt   DateTime             @default(now())
  supersededAt DateTime?
  learner     User                 @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lessons     LearningPlanLesson[]
  events      LearningPlanEvent[]

  @@index([learnerId, createdAt])
  @@index([learnerId, supersededAt])
}

model LearningPlanLesson {
  id          String              @id @default(cuid())
  planId      String
  lessonKey   String
  position    Int
  skillId     String
  lesson      Json
  plan        LearningPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  events      LearningPlanEvent[]

  @@unique([planId, lessonKey])
  @@unique([planId, position])
}

model LearningPlanEvent {
  id        String              @id @default(cuid())
  planId    String
  lessonId  String?
  type      String
  createdAt DateTime            @default(now())
  metadata  Json?
  plan      LearningPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  lesson    LearningPlanLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([planId, createdAt])
  @@index([lessonId])
}

model Workspace {
