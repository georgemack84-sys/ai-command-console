generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  viewer
  operator
  approver
  admin
}

enum UserStatus {
  active
  disabled
}

enum WorkspaceMemberRole {
  owner
  admin
  member
  viewer
}

enum WorkspaceInviteStatus {
  pending
  accepted
  revoked
}

enum SourceType {
  website
  repository
  integration
  feed
  document
}

enum SourceStatus {
  healthy
  degraded
  paused
}

enum AlertStatus {
  unread
  read
  archived
}

enum AlertSeverity {
  info
  warning
  critical
}

enum UpdateSeverity {
  low
  medium
  high
  critical
}

enum InsightType {
  summary
  insight
  recommendation
  classification
}

enum InsightStatus {
  ready
  draft
  archived
}

enum AgentTaskStatus {
  queued
  running
  completed
  failed
  canceled
}

enum AgentExecutionStatus {
  running
  completed
  failed
}

enum BriefStatus {
  draft
  queued
  in_progress
  in_review
  complete
}

enum BriefPriority {
  low
  medium
  high
}

enum ReportFormat {
  memo
  briefing
  comparison
  outline
}

enum ReportStatus {
  draft
  ready
  published
}

enum KnowledgeScopeKind {
  global
  program
  project
  component
  task
  session
}

enum KnowledgeInheritance {
  inheritable
  local_only
}

enum KnowledgePromotionStatus {
  pending
  approved
  rejected
}

model User {
  id                        String                     @id @default(cuid())
  email                     String                     @unique
  passwordHash              String
  name                      String
  role                      UserRole                   @default(operator)
  status                    UserStatus                 @default(active)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  memberships               WorkspaceMember[]
  sessions                  AuthSession[]
  activities                ActivityEvent[]
  briefs                    ResearchBrief[]
  reports                   ResearchReport[]
  savedViews                SavedView[]
  alerts                    Alert[]
  createdInvites            WorkspaceInvite[]          @relation("CreatedWorkspaceInvites")
  acceptedInvites           WorkspaceInvite[]          @relation("AcceptedWorkspaceInvites")
  skillEvidence             SkillEvidence[]
  skillStates               SkillLearnerState[]
  skillRecommendationEvents SkillRecommendationEvent[]
  assessmentSessions        AssessmentSession[]
  competencyProfiles        CompetencyProfile[]
  assessmentRecommendations AssessmentRecommendation[]
  learningPlans             LearningPlan[]
  knowledgeEntries          KnowledgeEntry[]           @relation("KnowledgeCreatedBy")
  requestedKnowledgePromotions KnowledgePromotion[]    @relation("KnowledgePromotionRequestedBy")
  approvedKnowledgePromotions  KnowledgePromotion[]    @relation("KnowledgePromotionApprovedBy")
  headlineFlowEventPreferences HeadlineFlowEventPreference[]
  headlineFlowInteractionEvents HeadlineFlowInteractionEvent[]
}

model SkillNode {
  id                   String                @id
  slug                 String                @unique
  name                 String
  description          String
  status               String
  modelVersion         String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  outgoingEdges        SkillEdge[]           @relation("SkillEdgeFrom")
  incomingEdges        SkillEdge[]           @relation("SkillEdgeTo")
  evidence             SkillEvidence[]
  states               SkillLearnerState[]
  assessmentBlueprints AssessmentBlueprint[]
  assessmentItems      AssessmentItem[]
  competencyProfiles   CompetencyProfile[]
}

model SkillEdge {
  id          String    @id
  fromSkillId String
  toSkillId   String
  type        String
  strength    Float?
  rationale   String
  createdAt   DateTime  @default(now())
  fromSkill   SkillNode @relation("SkillEdgeFrom", fields: [fromSkillId], references: [id], onDelete: Cascade)
  toSkill     SkillNode @relation("SkillEdgeTo", fields: [toSkillId], references: [id], onDelete: Cascade)

  @@unique([fromSkillId, toSkillId, type])
}

model SkillEvidence {
  id                   String             @id
  learnerId            String
  skillId              String
  kind                 String
  occurredAt           DateTime
  score                Float?
  outcome              String
  evaluator            String
  sourceRef            String?
  notes                String?
  rubricVersion        String?
  assessmentSessionId  String?
  assessmentItemId     String?
  evaluationType       String?
  competencyDimensions String[]
  learner              User               @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  skill                SkillNode          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  assessmentSession    AssessmentSession? @relation("AssessmentSessionEvidence", fields: [assessmentSessionId], references: [id], onDelete: SetNull)
  assessmentItem       AssessmentItem?    @relation("AssessmentItemEvidence", fields: [assessmentItemId], references: [id], onDelete: SetNull)

  @@index([learnerId, skillId, occurredAt])
  @@index([assessmentSessionId])
  @@index([assessmentItemId])
}

model AssessmentBlueprint {
  id                 String              @id @default(cuid())
  skillId            String
  version            String
  objectives         Json
  assessedSkillIds   String[]
  targetCompetencies String[]
  itemMix            Json
  itemPlan           Json
  rules              Json
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  skill              SkillNode           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  items              AssessmentItem[]
  sessions           AssessmentSession[]

  @@unique([skillId, version])
}

model AssessmentItem {
  id                     String               @id @default(cuid())
  skillId                String
  blueprintId            String?
  evaluationType         String
  prompt                 String
  expectedResponseFormat String
  rubric                 Json
  difficulty             Int
  version                String
  competencyDimensions   String[]
  content                Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  skill                  SkillNode            @relation(fields: [skillId], references: [id], onDelete: Cascade)
  blueprint              AssessmentBlueprint? @relation(fields: [blueprintId], references: [id], onDelete: SetNull)
  responses              AssessmentResponse[]
  sessionItems           AssessmentSessionItem[]
  evidence               SkillEvidence[]      @relation("AssessmentItemEvidence")

  @@index([skillId, evaluationType, version])
  @@index([blueprintId])
}

model AssessmentSession {
  id                 String                    @id @default(cuid())
  learnerId          String
  blueprintId        String
  targetSkillIds     String[]
  state              String
  blueprintVersion   String
  startedAt          DateTime                  @default(now())
  completedAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  learner            User                      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  blueprint          AssessmentBlueprint       @relation(fields: [blueprintId], references: [id], onDelete: Restrict)
  responses          AssessmentResponse[]
  sessionItems       AssessmentSessionItem[]
  evidence           SkillEvidence[]           @relation("AssessmentSessionEvidence")
  competencyProfiles CompetencyProfile[]
  recommendation     AssessmentRecommendation?

  @@index([learnerId, state])
}

model AssessmentResponse {
  id                  String            @id @default(cuid())
  sessionId           String
  itemId              String
  answer              Json
  selfRatedConfidence Float?
  evaluationResult    Json?
  feedback            String?
  submittedAt         DateTime          @default(now())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  session             AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item                AssessmentItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([sessionId, itemId])
  @@index([itemId])
}

model AssessmentSessionItem {
  id        String            @id @default(cuid())
  sessionId String
  itemId    String
  position  Int
  createdAt DateTime          @default(now())
  session   AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item      AssessmentItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([sessionId, itemId])
  @@unique([sessionId, position])
  @@index([itemId])
}

model CompetencyProfile {
  id                 String            @id @default(cuid())
  sessionId          String
  learnerId          String
  skillId            String
  knowledge          Float?
  application        Float?
  troubleshooting    Float?
  retention          Float?
  calibration        Float?
  score              Float?
  confidenceInterval Json
  evidenceCount      Int
  calculationVersion String
  calculatedAt       DateTime          @default(now())
  session            AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learner            User              @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  skill              SkillNode         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([sessionId, skillId])
  @@index([learnerId, skillId, calculatedAt])
}

model AssessmentRecommendation {
  id                         String            @id @default(cuid())
  sessionId                  String            @unique
  learnerId                  String
  instructionalStartingPoint String
  priorityGaps               Json
  retestAt                   DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  session                    AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  learner                    User              @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, createdAt])
}

model SkillLearnerState {
  id                 String    @id @default(cuid())
  learnerId          String
  skillId            String
  mastery            Float?
  confidence         Float
  retentionScore     Float?
  lastEvaluated      DateTime?
  displayState       String
  calculationVersion String
  calculatedAt       DateTime
  evidenceIds        String[]
  learner            User      @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  skill              SkillNode @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([learnerId, skillId])
}

model SkillRecommendationEvent {
  id             String   @id @default(cuid())
  learnerId      String
  targetSkillId  String?
  blockedSkillId String
  outcome        String
  createdAt      DateTime @default(now())
  learner        User     @relation(fields: [learnerId], references: [id], onDelete: Cascade)

  @@index([learnerId, createdAt])
}

model LearningPlan {
  id          String               @id @default(cuid())
  learnerId   String
  version     String
  status      String
  goal        Json
  constraints Json
  plan        Json
  createdAt   DateTime             @default(now())
  supersededAt DateTime?
  learner     User                 @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  lessons     LearningPlanLesson[]
  events      LearningPlanEvent[]

  @@index([learnerId, createdAt])
  @@index([learnerId, supersededAt])
}

model LearningPlanLesson {
  id          String              @id @default(cuid())
  planId      String
  lessonKey   String
  position    Int
  skillId     String
  lesson      Json
  plan        LearningPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  events      LearningPlanEvent[]

  @@unique([planId, lessonKey])
  @@unique([planId, position])
}

model LearningPlanEvent {
  id        String              @id @default(cuid())
  planId    String
  lessonId  String?
  type      String
  createdAt DateTime            @default(now())
  metadata  Json?
  plan      LearningPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  lesson    LearningPlanLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([planId, createdAt])
  @@index([lessonId])
}

model Workspace {
  id                        String                           @id @default(cuid())
  name                      String
  slug                      String                           @unique
  description               String
  plan                      String                           @default("scale")
  statusTone                String                           @default("healthy")
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt
  members                   WorkspaceMember[]
  sources                   Source[]
  updates                   MonitoredUpdate[]
  insights                  Insight[]
  activity                  ActivityEvent[]
  savedViews                SavedView[]
  briefs                    ResearchBrief[]
  reports                   ResearchReport[]
  invites                   WorkspaceInvite[]
  alerts                    Alert[]
  featureFlags              WorkspaceFeatureFlag[]
  agentTasks                AgentTask[]
  operationsState           WorkspaceOperationsState?
  operationsFollowups       OperationsFollowup[]
  incidentApprovals         IncidentApprovalRequest[]
  policyOverride            WorkspacePolicyOverride?
  playbookRolloutWorkspaces PolicyPlaybookRolloutWorkspace[]
  knowledgeScopes           KnowledgeScope[]
  knowledgeEntries          KnowledgeEntry[]
  knowledgePromotions       KnowledgePromotion[]
  knowledgeSemanticKeys     KnowledgeSemanticKeyRecord[]
  headlineFlowEvents        HeadlineFlowEvent[]
  headlineFlowEventPreferences HeadlineFlowEventPreference[]
  headlineFlowInteractionEvents HeadlineFlowInteractionEvent[]
}

model HeadlineFlowEvent {
  id                      String                     @id
  workspaceId             String
  title                   String
  summary                 String
  topic                   String
  status                  String
  importance              String
  confidence              String
  firstDetectedAt         DateTime
  lastUpdatedAt           DateTime
  lastMeaningfulUpdateAt  DateTime
  version                 Int                        @default(1)
  matchKey                String
  updateSummary           String                     @default("Event continuity updated.")
  updateReasons           String[]                   @default([])
  sourceCount             Int                        @default(0)
  articleCount            Int                        @default(0)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  workspace               Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  evidence                HeadlineFlowEventEvidence[]
  preferences             HeadlineFlowEventPreference[]

  @@unique([workspaceId, matchKey])
  @@index([workspaceId, topic, lastUpdatedAt])
  @@index([workspaceId, status, lastMeaningfulUpdateAt])
  @@map("headline_flow_events")
}

model HeadlineFlowEventPreference {
  id           String            @id @default(cuid())
  workspaceId  String
  userId       String
  eventId      String
  savedAt      DateTime?
  mutedAt      DateTime?
  resolvedAt   DateTime?
  restoredAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        HeadlineFlowEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, eventId])
  @@index([workspaceId, userId, mutedAt])
  @@index([workspaceId, userId, resolvedAt])
  @@index([workspaceId, userId, savedAt])
  @@map("headline_flow_event_preferences")
}

model HeadlineFlowInteractionEvent {
  id           String            @id @default(cuid())
  workspaceId  String
  userId       String
  eventId      String?
  storyId      String?
  topic        String?
  action       String
  providerId   String?
  sourceName   String?
  metadata     Json?
  occurredAt   DateTime          @default(now())
  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, occurredAt])
  @@index([workspaceId, action, occurredAt])
  @@index([workspaceId, topic, occurredAt])
  @@index([workspaceId, eventId, occurredAt])
  @@map("headline_flow_interaction_events")
}

model HeadlineFlowEventEvidence {
  id             String            @id
  eventId        String
  workspaceId    String
  storyPackageId String
  articleId      String?
  providerId     String?
  providerArticleId String?
  sourceId       String
  sourceName     String
  articleUrl     String?
  articleFingerprint String?
  author         String?
  imageUrl       String?
  headline       String
  summary        String
  topic          String
  publishedAt    DateTime
  retrievedAt    DateTime?
  observedAt     DateTime
  updateReason   String            @default("new_evidence")
  createdAt      DateTime          @default(now())
  event          HeadlineFlowEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, eventId, articleUrl])
  @@index([workspaceId, topic, observedAt])
  @@index([providerId, providerArticleId])
  @@index([articleFingerprint])
  @@index([eventId, observedAt])
  @@map("headline_flow_event_evidence")
}

model KnowledgeScope {
  id          String             @id @default(cuid())
  workspaceId String
  name        String
  kind        KnowledgeScopeKind
  parentId    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent      KnowledgeScope?    @relation("KnowledgeScopeHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    KnowledgeScope[]   @relation("KnowledgeScopeHierarchy")
  records     KnowledgeEntry[]
  promotionTargets KnowledgePromotion[]

  @@index([workspaceId, kind])
  @@index([workspaceId, parentId])
}

model KnowledgeEntry {
  id                String                @id @default(cuid())
  workspaceId       String
  scopeId           String
  title             String
  content           String
  semanticKey       String
  semanticValue     String
  inheritance       KnowledgeInheritance  @default(local_only)
  visibility        String                @default("workspace")
  sourceKnowledgeId String?
  sourceScopeId     String?
  overrideOfId      String?
  supersededAt      DateTime?
  supersededById    String?
  createdById       String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scope             KnowledgeScope        @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  createdBy         User                  @relation("KnowledgeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  sourceKnowledge   KnowledgeEntry?       @relation("KnowledgeSourceLineage", fields: [sourceKnowledgeId], references: [id], onDelete: SetNull)
  derivedKnowledge  KnowledgeEntry[]      @relation("KnowledgeSourceLineage")
  overrideOf        KnowledgeEntry?       @relation("KnowledgeOverrides", fields: [overrideOfId], references: [id], onDelete: SetNull)
  overrides         KnowledgeEntry[]      @relation("KnowledgeOverrides")
  promotionRequests KnowledgePromotion[]  @relation("KnowledgePromotionSource")
  promotedKnowledge KnowledgePromotion[]  @relation("KnowledgePromotionResult")

  @@index([workspaceId, scopeId, updatedAt])
  @@index([workspaceId, semanticKey])
  @@index([scopeId, inheritance])
  @@index([overrideOfId])
}

model KnowledgePromotion {
  id                  String                   @id @default(cuid())
  workspaceId         String
  sourceKnowledgeId   String
  targetScopeId       String
  promotedKnowledgeId String?                  @unique
  provenanceRecordId  String?                  @map("provenance_record_id")
  status              KnowledgePromotionStatus @default(pending)
  requestedById       String
  approvedById        String?
  rejectionReason     String?
  requestedAt         DateTime                 @default(now())
  resolvedAt          DateTime?
  workspace           Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceKnowledge     KnowledgeEntry           @relation("KnowledgePromotionSource", fields: [sourceKnowledgeId], references: [id], onDelete: Cascade)
  promotedKnowledge   KnowledgeEntry?          @relation("KnowledgePromotionResult", fields: [promotedKnowledgeId], references: [id], onDelete: SetNull)
  targetScope         KnowledgeScope           @relation(fields: [targetScopeId], references: [id], onDelete: Cascade)
  requestedBy         User                     @relation("KnowledgePromotionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy          User?                    @relation("KnowledgePromotionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, requestedAt])
  @@index([targetScopeId, status])
  @@index([workspaceId, provenanceRecordId])
}

model KnowledgeSemanticKeyRecord {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  key               String
  description       String
  allowedScopeKinds String[]  @map("allowed_scope_kinds")
  valueKind         String    @map("value_kind")
  allowedValues     String[]  @map("allowed_values")
  ownerId           String    @map("owner_id")
  version           Int       @default(1)
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
  @@map("knowledge_semantic_key_registry")
}

model KnowledgeSemanticKeyVersionRecord {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  key               String
  version           Int
  description       String
  allowedScopeKinds String[] @map("allowed_scope_kinds")
  valueKind         String   @map("value_kind")
  allowedValues     String[] @map("allowed_values")
  ownerId           String   @map("owner_id")
  status            String
  changeRequestId   String?  @map("change_request_id")
  activatedAt       DateTime @map("activated_at")
  retiredAt         DateTime? @map("retired_at")

  @@unique([workspaceId, key, version])
  @@map("knowledge_semantic_key_versions")
}

model KnowledgeSemanticKeyChangeRequestRecord {
  requestId         String   @id @map("request_id")
  workspaceId       String   @map("workspace_id")
  key               String
  operation         String   @default("UPSERT")
  baseVersion       Int      @map("base_version")
  description       String
  allowedScopeKinds String[] @map("allowed_scope_kinds")
  valueKind         String   @map("value_kind")
  allowedValues     String[] @map("allowed_values")
  requestedById     String   @map("requested_by_id")
  status            String   @default("PENDING")
  approvedById      String?  @map("approved_by_id")
  rejectionReason   String?  @map("rejection_reason")
  requestedAt       DateTime @default(now()) @map("requested_at")
  resolvedAt        DateTime? @map("resolved_at")

  @@index([workspaceId, status, requestedAt])
  @@map("knowledge_semantic_key_change_requests")
}

model WorkspaceInvite {
  id               String                @id @default(cuid())
  token            String                @unique
  email            String?
  workspaceId      String
  createdById      String
  status           WorkspaceInviteStatus @default(pending)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  acceptedAt       DateTime?
  acceptedByUserId String?
  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User                  @relation("CreatedWorkspaceInvites", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy       User?                 @relation("AcceptedWorkspaceInvites", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([email, status])
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceMemberRole @default(member)
  isDefault   Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipHash     String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Source {
  id            String            @id @default(cuid())
  workspaceId   String
  name          String
  type          SourceType
  status        SourceStatus      @default(healthy)
  url           String?
  updateCadence String
  description   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updates       MonitoredUpdate[]
  alerts        Alert[]
}

model MonitoredUpdate {
  id          String         @id @default(cuid())
  workspaceId String
  sourceId    String
  title       String
  summary     String
  status      String
  severity    UpdateSeverity @default(medium)
  category    String
  happenedAt  DateTime
  createdAt   DateTime       @default(now())
  metadata    Json?
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source      Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  alerts      Alert[]
}

model Insight {
  id          String        @id @default(cuid())
  workspaceId String
  title       String
  summary     String
  type        InsightType
  status      InsightStatus @default(ready)
  confidence  Int
  score       Int           @default(0)
  sourceIds   String[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  metadata    Json?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  alerts      Alert[]
}

model Alert {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String?
  sourceId    String?
  updateId    String?
  insightId   String?
  type        String
  title       String
  message     String
  severity    AlertSeverity    @default(info)
  status      AlertStatus      @default(unread)
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
