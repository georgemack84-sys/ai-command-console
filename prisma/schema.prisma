// Phase 7: append-only historical provenance. Payload remains typed by the
// learning-constitution contract while the ledger retains every record kind.
model NoesisProvenanceRecord {
  recordId   String   @id @map("record_id")
  workspaceId String  @map("workspace_id")
  recordType String   @map("record_type")
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([workspaceId, recordType, createdAt])
  @@map("noesis_provenance_records")
}

model NoesisProvenanceRelationship {
  relationshipId   String   @id @map("relationship_id")
  workspaceId      String   @map("workspace_id")
  fromRecordId     String   @map("from_record_id")
  toRecordId       String   @map("to_record_id")
  relationshipType String   @map("relationship_type")
  actor            Json
  createdAt        DateTime @map("created_at")

  @@unique([workspaceId, fromRecordId, toRecordId, relationshipType])
  @@index([workspaceId, fromRecordId, createdAt])
  @@index([workspaceId, toRecordId, createdAt])
  @@map("noesis_provenance_relationships")
}
