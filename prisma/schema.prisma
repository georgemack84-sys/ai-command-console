// Vault records are append-only snapshots. recordId is the logical ID; storageId
// identifies an immutable persisted snapshot so supersession never rewrites history.
model NuruVaultRecord {
  storageId     String   @id @default(cuid())
  sequence      BigInt   @unique @default(autoincrement())
  workspaceId   String
  recordId      String
  kind          String
  schemaVersion String
  classification String
  correlationId String
  payload       Json
  recordedAt    DateTime @default(now())

  @@index([workspaceId, recordId, sequence])
  @@index([workspaceId, kind, sequence])
  @@index([workspaceId, correlationId, sequence])
}
