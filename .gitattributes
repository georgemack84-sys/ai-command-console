# Normalize repository text to LF unless a reviewed tool constraint requires
# another working-tree line ending.
* text=auto eol=lf
*.sh text eol=lf

# Windows-native working-tree exceptions retained by the GP-01 baseline.
*.ps1 text eol=crlf
*.sln text eol=crlf

# This committed catalog is owned by generate-permission-catalog.mjs and its
# freshness check; identify it as generated for review tooling.
apps/web/src/generated/permission-catalog.ts linguist-generated=true

# Binary assets must never enter text normalization or merge processing.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
