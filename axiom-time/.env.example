# Axiom Time is fully useful without any environment configuration.
# Add optional adapter configuration here in later phases.
NEXT_PUBLIC_AXIOM_ADAPTERS_URL=

# Adapter service only: set server-side environment variables in the service host,
# never in the mobile/web bundle.
AXIOM_ADAPTER_ALLOWED_ORIGINS=http://localhost:3000,capacitor://localhost,https://localhost
AXIOM_PROPRIUM_URL=
AXIOM_PROPRIUM_TOKEN=
