{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "background": {
      "app": { "$value": "#020807", "$type": "color" },
      "subtle": { "$value": "rgb(0 255 136 / 8%)", "$type": "color" }
    },
    "surface": {
      "panel": { "$value": "rgb(4 17 15 / 78%)", "$type": "color" },
      "raised": { "$value": "rgb(7 26 23 / 82%)", "$type": "color" },
      "selected": { "$value": "rgb(0 255 136 / 16%)", "$type": "color" }
    },
    "text": {
      "primary": { "$value": "#f4fff9", "$type": "color" },
      "secondary": { "$value": "#a8b8b7", "$type": "color" },
      "inverse": { "$value": "#00130d", "$type": "color" }
    },
    "border": {
      "default": { "$value": "rgb(148 255 207 / 14%)", "$type": "color" },
      "strong": { "$value": "rgb(148 255 207 / 28%)", "$type": "color" }
    },
    "accent": {
      "default": { "$value": "#20f779", "$type": "color" },
      "strong": { "$value": "#0ecb62", "$type": "color" }
    },
    "intent": {
      "focus": { "$value": "#50ffac", "$type": "color" },
      "danger": { "$value": "#ff5f86", "$type": "color" },
      "dangerSurface": { "$value": "rgb(255 95 134 / 12%)", "$type": "color" }
    }
  },
  "space": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "5": { "$value": "20px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "10": { "$value": "40px", "$type": "dimension" }
  },
  "radius": {
    "sm": { "$value": "4px", "$type": "dimension" },
    "md": { "$value": "8px", "$type": "dimension" }
  },
  "font": {
    "family": {
      "ui": { "$value": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "SFMono-Regular, Consolas, Liberation Mono, monospace", "$type": "fontFamily" }
    }
  },
  "shadow": {
    "sm": { "$value": "0 12px 40px rgb(0 0 0 / 22%)", "$type": "shadow" },
    "md": { "$value": "0 24px 80px rgb(0 0 0 / 42%)", "$type": "shadow" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration" },
      "base": { "$value": "180ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" }
    }
  }
}
