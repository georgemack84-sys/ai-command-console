NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# local (browser only), self-hosted (default), or supabase
NEXT_PUBLIC_HOUSEHOLD_STORAGE=self-hosted
# Optional: set both values to require a PIN for the self-hosted household server.
HOUSEHOLD_ACCESS_PIN=choose-a-6-digit-pin
HOUSEHOLD_SESSION_SECRET=replace-with-a-long-random-secret
