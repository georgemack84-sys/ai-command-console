# Proprium repository environment template
# Owner: Repository Platform
# Local counterpart: .env (developer-owned and ignored)
# Safe to commit: non-production examples only; never add production secrets.
# Copy to .env only when overriding the deterministic Compose defaults below.
# Scope: local Compose infrastructure. Application runtime settings belong to
# their application-owned templates.
COMPOSE_PROJECT_NAME=proprium

# PostgreSQL provisioning. The password is a non-production placeholder.
POSTGRES_DATABASE=proprium
POSTGRES_USER=proprium
POSTGRES_PASSWORD=local-development-only
POSTGRES_HOST_PORT=55432

# Redis is unauthenticated in the local Compose profile.
REDIS_HOST_PORT=6379

# Host-facing application ports. Container-internal ports remain fixed.
API_PORT=8080
WEB_PORT=3000

# Transitional root application contract. These settings belong to the legacy
# command-console surface and remain here until that surface is migrated; they
# are not part of the Proprium GP-02 inventory.
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/ai_command_console?schema=public
LEGACY_AUTONOMOUS_EXECUTION_ENABLED=false
LEGACY_AUTONOMOUS_EXECUTION_RISK_ACCEPTED=false
# Run `npm run dev:doctor` if local Prisma routes cannot reach Postgres.
TENANT_MODE=single_tenant
LOCK_LEASE_MS=30000
BACKUP_PATH=./.codex-temp/backups
OBSERVABILITY_MODE=basic
SECURITY_MODE=enforced
ADMIN_SECRET=local-development-only-admin-placeholder
CONTINUITY_VERIFICATION_ENABLED=false
INTEGRITY_VALIDATION_ENABLED=false
RESTORE_SIMULATION_ENABLED=false
FAIL_FAST_ENABLED=true
DEBUG_MODE=false
NEXT_PUBLIC_APP_URL=http://localhost:5050
# Exact HTTPS origin of the separately deployed learning app. Credentialed
# CORS is disabled unless this is set; never use a wildcard.
LEARNING_AGENT_ORIGIN=http://localhost:5051
LOG_LEVEL=info
AI_COMMAND_CONSOLE_AUTH_SECRET=replace-this-with-a-long-secret
OPENAI_API_KEY=
HEADLINE_FLOW_PROVIDER=rss
HEADLINE_FLOW_RSS_TIMEOUT_MS=5000
HEADLINE_FLOW_LINK_RESOLUTION_TIMEOUT_MS=800
HEADLINE_FLOW_LINK_RESOLUTION_MAX_ATTEMPTS=6
HEADLINE_FLOW_FEED_CACHE_TTL_MS=120000
HEADLINE_FLOW_STALE_CACHE_MAX_AGE_MS=600000
HEADLINE_FLOW_MIN_READY_STORIES=6
HEADLINE_FLOW_MIN_READY_TOPICS=4
# Local/demo only. Keep false for production and opt into fixtures only in test/demo environments.
HEADLINE_FLOW_ALLOW_FIXTURE_PROVIDER=false
HEADLINE_FLOW_WEB_SEARCH_MODEL=gpt-4.1-mini
HEADLINE_FLOW_WEB_SEARCH_TIMEOUT_MS=30000
HEADLINE_FLOW_AUTO_FALLBACK_TIMEOUT_MS=35000
HEADLINE_FLOW_INTERACTION_RETENTION_DAYS=90
AI_SUMMARY_PROVIDER_MODE=auto
AI_SUMMARY_MODEL=gpt-4.1-mini
AI_SUMMARY_TIMEOUT_MS=8000
AI_SUMMARY_MAX_ATTEMPTS=2
AI_SUMMARY_ALLOW_MOCK_FALLBACK=true
AI_SUMMARY_DAILY_BUDGET_USD=1
AI_SUMMARY_ESTIMATED_COST_PER_RUN_USD=0.02
AI_SUMMARY_EVAL_ENABLED=true
RSS_INGEST_TIMEOUT_MS=10000
RSS_INGEST_MAX_ITEMS=30
RSS_INGEST_MAX_CONTENT_BYTES=2000000
RSS_USER_AGENT=AI-Command-Console/1.0 (+https://example.com)
# Keep false unless you are intentionally testing trusted local fixture feeds.
SOURCE_ALLOW_PRIVATE_URLS=false
JOB_QUEUE_EXECUTION_MODE=external
JOB_WORKER_POLL_INTERVAL_MS=2000
JOB_QUEUE_MAX_PENDING=100
JOB_QUEUE_MAX_RUNNING=12
# The external worker performs a durable scoped-work alert scan on this cadence.
SCOPE_ALERT_SCAN_ENABLED=true
SCOPE_ALERT_SCAN_INTERVAL_MS=300000
SCOPE_ALERT_SCAN_CONCURRENCY=8
# Reopen a resolved alert only if its condition remains unresolved for this long.
SCOPE_ALERT_RENOTIFY_AFTER_MS=86400000
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
POSTHOG_ENABLED=true
FEATURE_FLAGS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_LIMIT=8
RATE_LIMIT_SOURCE_LIMIT=20
RATE_LIMIT_JOBS_LIMIT=30
AI_COMMAND_CONSOLE_DATA_ROOT=./.codex-temp/runtime-data
AI_COMMAND_CONSOLE_STORAGE_DRIVER=sqlite
AI_COMMAND_CONSOLE_DATABASE_PATH=./.codex-temp/runtime-data/workspace.sqlite
AI_COMMAND_CONSOLE_AGENTS_DATABASE_PATH=./.codex-temp/runtime-data/agents/console.sqlite
AI_COMMAND_CONSOLE_WRITE_LEGACY_JSON_MIRRORS=false
AI_COMMAND_CONSOLE_SECURE_COOKIES=false
AI_COMMAND_CONSOLE_SESSION_MAX_AGE_SECONDS=1209600
AI_COMMAND_CONSOLE_ALERT_WEBHOOK_URL=
AI_COMMAND_CONSOLE_ALERT_WEBHOOK_SEVERITIES=high,critical
AI_COMMAND_CONSOLE_ALERT_WEBHOOK_THROTTLE_SECONDS=900
