# Proprium shared repository configuration (development-only placeholders).
# APP_NAME: display name; required; non-secret; all environments.
APP_NAME=Proprium
# APP_ENVIRONMENT: Development, Test, Staging, or Production; required; non-secret.
APP_ENVIRONMENT=Development
# APP_VERSION: semantic application version; required; non-secret.
APP_VERSION=0.1.0
# POSTGRES_*: Compose database location and credentials; required for infrastructure; password is secret.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=proprium
POSTGRES_USER=proprium
POSTGRES_PASSWORD=change-me
# REDIS_*: non-authoritative Day 4 cache; password is optional and secret when provided.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# API_PORT and WEB_PORT: local host ports; required; non-secret.
API_PORT=8080
WEB_PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:55432/ai_command_console?schema=public
# Run `npm run dev:doctor` if local Prisma routes cannot reach Postgres.
TENANT_MODE=single_tenant
LOCK_LEASE_MS=30000
BACKUP_PATH=./.codex-temp/backups
OBSERVABILITY_MODE=basic
SECURITY_MODE=enforced
ADMIN_SECRET=local-admin-secret-key-123
CONTINUITY_VERIFICATION_ENABLED=false
INTEGRITY_VALIDATION_ENABLED=false
RESTORE_SIMULATION_ENABLED=false
FAIL_FAST_ENABLED=true
DEBUG_MODE=false
NEXT_PUBLIC_APP_URL=http://localhost:5050
LOG_LEVEL=info
AI_COMMAND_CONSOLE_AUTH_SECRET=replace-this-with-a-long-secret
OPENAI_API_KEY=
AI_SUMMARY_PROVIDER_MODE=auto
AI_SUMMARY_MODEL=gpt-4.1-mini
AI_SUMMARY_TIMEOUT_MS=8000
AI_SUMMARY_MAX_ATTEMPTS=2
AI_SUMMARY_ALLOW_MOCK_FALLBACK=true
AI_SUMMARY_DAILY_BUDGET_USD=1
AI_SUMMARY_ESTIMATED_COST_PER_RUN_USD=0.02
AI_SUMMARY_EVAL_ENABLED=true
RSS_INGEST_TIMEOUT_MS=10000
RSS_INGEST_MAX_ITEMS=30
RSS_INGEST_MAX_CONTENT_BYTES=2000000
RSS_USER_AGENT=AI-Command-Console/1.0 (+https://example.com)
JOB_QUEUE_EXECUTION_MODE=external
JOB_WORKER_POLL_INTERVAL_MS=2000
JOB_QUEUE_MAX_PENDING=100
JOB_QUEUE_MAX_RUNNING=12
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
POSTHOG_ENABLED=true
FEATURE_FLAGS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_LIMIT=8
RATE_LIMIT_SOURCE_LIMIT=20
RATE_LIMIT_JOBS_LIMIT=30
AI_COMMAND_CONSOLE_DATA_ROOT=./.codex-temp/runtime-data
AI_COMMAND_CONSOLE_STORAGE_DRIVER=sqlite
AI_COMMAND_CONSOLE_DATABASE_PATH=./.codex-temp/runtime-data/workspace.sqlite
AI_COMMAND_CONSOLE_AGENTS_DATABASE_PATH=./.codex-temp/runtime-data/agents/console.sqlite
AI_COMMAND_CONSOLE_WRITE_LEGACY_JSON_MIRRORS=false
AI_COMMAND_CONSOLE_SECURE_COOKIES=false
AI_COMMAND_CONSOLE_SESSION_MAX_AGE_SECONDS=1209600
AI_COMMAND_CONSOLE_ALERT_WEBHOOK_URL=
AI_COMMAND_CONSOLE_ALERT_WEBHOOK_SEVERITIES=high,critical
AI_COMMAND_CONSOLE_ALERT_WEBHOOK_THROTTLE_SECONDS=900

# Headline Flow
NEWS_PROVIDER=mock
NEWS_PROVIDERS=mock
WEB_NEWS_SEARCH_BASE_URL=https://www.bing.com/news/search
WEB_NEWS_SEARCH_TIMEOUT_MS=12000
WEB_NEWS_MAX_AGE_HOURS=48
VISUAL_SYNC_TIMEOUT_MS=5000
NEWS_RSS_FEEDS=
NEWS_API_KEY=
NEWS_API_BASE_URL=
GNEWS_API_KEY=
GNEWS_API_BASE_URL=
GUARDIAN_API_KEY=
GUARDIAN_API_BASE_URL=
NEWS_PROVIDER_TIMEOUT_MS=7000
NEWS_CACHE_TTL_MS=90000
HEADLINE_FLOW_CIVITAS_ENABLED=false
HEADLINE_FLOW_CAF_ENABLED=false
HEADLINE_FLOW_TRUST_ENABLED=false
HEADLINE_FLOW_PROVING_ENABLED=true
HEADLINE_FLOW_TELEMETRY_ENABLED=true
HEADLINE_FLOW_DASHBOARD_ENABLED=true
HEADLINE_FLOW_RECOMMENDATIONS_ENABLED=false
HEADLINE_FLOW_BRIEFING_ENABLED=false
HEADLINE_FLOW_VOICE_ENABLED=false
HEADLINE_FLOW_DISPLAY_PROFILE=desktop
