    "backend:architecture:fixtures": "node scripts/verify-backend-architecture-fixtures.cjs",
    "backend:architecture:test": "dotnet test services/api/Proprium.ArchitectureTests/Proprium.ArchitectureTests.csproj --configuration Release --no-build --no-restore --nologo --verbosity minimal --filter Category=Architecture",
    "validate:backend-architecture": "npm run backend:architecture:metadata && npm run backend:architecture:fixtures && npm run backend:architecture:test",
    "backend:test:unit": "dotnet test services/api/Proprium.ArchitectureTests/Proprium.ArchitectureTests.csproj --configuration Release --no-build --no-restore --nologo --verbosity minimal --filter Category=Unit",
