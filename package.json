    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.mjs --coverage",
    "test:noesis:phase8": "vitest run --config vitest.config.mjs --environment node --pool forks --maxWorkers 1 --no-file-parallelism tests/unit/learning-constitution/conflictEngineContract.test.ts tests/unit/learning-constitution/conflictRecordService.test.ts tests/unit/learning-constitution/conflictCandidateSearchService.test.ts tests/unit/learning-constitution/conflictComparisonService.test.ts tests/unit/learning-constitution/conflictResolutionPlanner.test.ts tests/unit/learning-constitution/conflictResolutionProposalService.test.ts tests/unit/learning-constitution/conflictSetAndImpact.test.ts tests/unit/learning-constitution/conflictWorkflowAndQuery.test.ts tests/unit/learning-constitution/conflictAdmissionGate.test.ts tests/unit/learning-constitution/conflictResolutionExecution.test.ts tests/unit/learning-constitution/conflictIntegrityScanner.test.ts tests/unit/learning-constitution/conflictReassessmentService.test.ts tests/unit/learning-constitution/conflictMetricsService.test.ts tests/unit/learning-constitution/promotionConflictAnalysisService.test.ts tests/unit/learning-constitution/phase8Acceptance.test.ts",
